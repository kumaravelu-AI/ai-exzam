# AI EXZAM provider selection
# Allowed values: mock, gemma, openai_compat
AI_PROVIDER=mock

# Gemma local endpoint settings
# Requires a running local model server that supports /v1/chat/completions
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_MODEL=gemma-3-12b-it
GEMMA_API_KEY=

# Generic OpenAI-compatible endpoint settings
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_COMPAT_MODEL=gemma-4
OPENAI_COMPAT_API_KEY=

# Optional Tamil naturalizer
# When true, the main tutor keeps English/intent/score as source of truth,
# then a second isolated LLM step rewrites only Tamil response fields.
TAMIL_NATURALIZER_ENABLED=false

# Performance options
# true = faster: use tutor Tamil when it passes local validation/cleanup.
# false = stricter: call the LLM for an extra English-to-Tamil rewrite.
TAMIL_NATURALIZER_FAST_MODE=true
GROQ_TIMEOUT_SECONDS=20

# Example modes:
#
# Mock mode:
# AI_PROVIDER=mock
#
# Gemma mode:
# AI_PROVIDER=gemma
#
# OpenAI-compatible mode:
# AI_PROVIDER=openai_compat
